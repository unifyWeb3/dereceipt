# Public configuration only. No keys, ever.
#
# Secrets are deliberately absent from this file. `GENLAYER_PRIVATE_KEY` is read
# from the process environment only: `scripts/gl_env.py` refuses to load a
# secret from `.env` and refuses to write credential material inside this
# checkout. Export it in your shell before running the scripts.
#
# Copy the non-secret values to `.env` if convenient:
#     cp .env.example .env
# and then export the key separately, so it never lands in a file at all.

# --- Target network: GenLayer Studio-dev (temporary; contracts can vanish) ---
GENLAYER_STUDIO_DEV_RPC=https://studio-dev.genlayer.com/api
GENLAYER_STUDIO_DEV_CHAIN_ID=61997

# The public deployer identity. This is an address, not a key.
DEPLOYER_ADDRESS=0x3211d1419709682b81c53CC51cb63622E25488d3

# Studio-dev has its own explorer. `GENLAYER_EXPLORER_URL` in some .env files
# points at Bradbury, which is a different network, and the scripts use this
# value instead. Override with GENLAYER_STUDIO_DEV_EXPLORER_URL if you need to.
GENLAYER_STUDIO_DEV_EXPLORER_URL=https://explorer-studio-dev.genlayer.com

# --- Fallback networks, not used by the default scripts ---
GENLAYER_FALLBACK_RPC_URL=https://studio.genlayer.com/api
GENLAYER_FALLBACK_CHAIN_ID=61999
GENLAYER_BRADBURY_RPC_URL=https://rpc-bradbury.genlayer.com
GENLAYER_BRADBURY_CHAIN_ID=4221

# --- Frontend (M5). The only public build variable. ---
# The deployed contract address. Left unset at M2 because the contract is
# written at M3; a zero address would be a claim that does not exist.
# VITE_CONTRACT_ADDRESS=0x...

# --- Deliberately unused ---
# APP_DATABASE_URL=sqlite:///local.db exists in the real .env and is NOT used by
# this project. The contract is the record. A second source of truth reads as an
# off-chain dependency to a reviewer.

# --- Pinned contract runner (not an environment variable) ---
# The contract header must carry exactly:
#   py-genlayer:5jycge4q8k23462jtb0b9fyey1s9qz928sz2nbrd9mg4sxqg2qng
# This was verified by probing the live target. The hash named in the published
# documentation is REJECTED by Studio-dev with `invalid_contract runner
# malformed`. Never alias the runner to `latest` or `test`.
