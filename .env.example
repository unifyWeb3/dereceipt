# Public configuration only. No keys.
# Copy to .env for non-secret values, or export them in the shell.
#
# Secrets are NOT listed here on purpose. GENLAYER_PRIVATE_KEY is read from the
# process environment only; scripts/gl_env.py refuses to load a secret from
# .env and refuses to write any credential path inside this checkout.

# --- Target network: GenLayer Studio-dev (temporary, may reset) ---
GENLAYER_STUDIO_DEV_RPC=https://studio-dev.genlayer.com/api
GENLAYER_STUDIO_DEV_CHAIN_ID=61997
DEPLOYER_ADDRESS=0x3211d1419709682b81c53CC51cb63622E25488d3

# --- Fallback networks ---
GENLAYER_FALLBACK_RPC_URL=https://studio.genlayer.com/api
GENLAYER_FALLBACK_CHAIN_ID=61999
GENLAYER_BRADBURY_RPC_URL=https://rpc-bradbury.genlayer.com
GENLAYER_BRADBURY_CHAIN_ID=4221

# --- Frontend build variable (M5) ---
# VITE_CONTRACT_ADDRESS=0x...

# --- Deliberately unused ---
# APP_DATABASE_URL exists in the real .env and is NOT used by this project.
# The contract is the record. A second source of truth reads as an off-chain
# dependency.
